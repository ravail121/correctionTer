<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /new/qa/

# Redirect old URLs to clean URLs (301 permanent redirect for SEO)
RewriteCond %{THE_REQUEST} \s/+new/qa/(index|efts|crypto|favorite)\.php\?filter=([^\s&]+) [NC]
RewriteRule ^ /new/qa/%2? [R=301,L]

# Handle clean URLs - rewrite to actual PHP files
# Big 7 (default)
RewriteRule ^big-7/?$ index.php?filter=big-7 [L,QSA]

# Crypto
RewriteRule ^crypto/?$ crypto.php?filter=crypto [L,QSA]

# Indexes (maps to efts.php)
RewriteRule ^indexes/?$ efts.php?filter=eft [L,QSA]

# Popular
RewriteRule ^popular/?$ index.php?filter=pouplar [L,QSA]

# Favorites
RewriteRule ^favorites/?$ favorite.php?filter=favorites [L,QSA]

# All
RewriteRule ^all/?$ index.php?filter=all [L,QSA]

# Default: if accessing root /new/qa/ or /new/qa/index.php without filter, show big-7
RewriteCond %{REQUEST_URI} ^/new/qa/?$
RewriteRule ^$ index.php?filter=big-7 [L,QSA]

# If accessing index.php without filter parameter, redirect to big-7
RewriteCond %{THE_REQUEST} \s/+new/qa/index\.php\s [NC]
RewriteRule ^index\.php$ /new/qa/big-7 [R=301,L]
</IfModule>

