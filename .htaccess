# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
# Use / when app is at document root (e.g. localhost, Docker). Use /correction1/ on production if in subdir.
RewriteBase /

# Clean URLs for filter pages - must come before WordPress rules
# Redirect old URLs to clean URLs (301 permanent redirect for SEO)
RewriteCond %{THE_REQUEST} \s/+((index|efts|crypto|favorite)\.php)\?filter=([^\s&]+) [NC]
RewriteRule ^ %3? [R=301,L]

# Redirect old About/Contact URLs with .php to clean versions
RewriteCond %{THE_REQUEST} \s/+about\.php[\s?] [NC]
RewriteRule ^about\.php$ /about-us [R=301,L]

RewriteCond %{THE_REQUEST} \s/+contact-us\.php[\s?] [NC]
RewriteRule ^contact-us\.php$ /contact-us [R=301,L]

# Handle clean URLs - rewrite to actual PHP files
# Big 7 (default)
RewriteRule ^big-7/?$ index.php?filter=big-7 [L,QSA]

# Crypto
RewriteRule ^crypto/?$ crypto.php?filter=crypto [L,QSA]

# Indexes (maps to efts.php)
RewriteRule ^indexes/?$ efts.php?filter=eft [L,QSA]

# Popular
RewriteRule ^popular/?$ index.php?filter=pouplar [L,QSA]

# Favorites
RewriteRule ^favorites/?$ favorite.php?filter=favorites [L,QSA]

# All
RewriteRule ^all/?$ index.php?filter=all [L,QSA]

# About & Contact pretty URLs
RewriteRule ^about-us/?$ about.php [L,QSA]
RewriteRule ^contact-us/?$ contact-us.php [L,QSA]

# Default: if accessing root without filter, show big-7
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^$ index.php?filter=big-7 [L,QSA]

RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
<IfModule mod_php7.c>
    php_value max_execution_time 1800
    php_value max_input_time 1800
</IfModule>

<IfModule mod_php5.c>
    php_value max_execution_time 1800
    php_value max_input_time 1800
</IfModule>

# Increase Apache timeout
<IfModule mod_reqtimeout.c>
    RequestReadTimeout header=30-60,MinRate=500 body=30,MinRate=500
</IfModule>

# END WordPress

# Custom redirect for blogs/home to the main domain
<IfModule mod_rewrite.c>
RewriteCond %{REQUEST_URI} ^/blogs/home/?$
RewriteRule ^(.*)$ https://correctionterritory.com/ [R=301,L]
</IfModule>
